<?xml version="1.0" encoding="utf-8"?>
<!--
  Builds an MSBuild solution against the shared libzce: zce.dll / zcepy.dll instead of the static
  libzce.lib (ymwang78/HostVM#42, ymwang78/libzce#213). Not imported by any project: a build opts in
  with  msbuild X.sln -p:ForceImportAfterCppTargets=<this file>  (HostVM's build.bat does), so the
  projects stay unchanged and every other solution keeps the static libzce.

  build_zce_dll.bat builds and installs the DLLs first: zce.lib / zcepy.lib into lib\win_amd64,
  zce.dll / zcepy.dll into bin\win_amd64. Release only; the DLLs are built with the release CRT.

  For each project but the ones listed in ZceDllApply below, it
  - defines ZCE_DLL and ZCEPY_DLL, so that ZCE_API and ZCEPY_API become dllimport;
  - puts include\zce\lua first, whose Lua 5.4.9 is the one compiled into zce.dll;
  - turns off C4251, as the CMake target zce does (std members of exported classes);
  - links zce.lib and zcepy.lib instead of libzce.lib / libzdl.lib / lua.lib, also where a
    #pragma comment(lib, ...) asks for those;
  - copies zce.dll and zcepy.dll next to an executable it builds.
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ZceDllRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..'))</ZceDllRoot>
    <ZceDllLibDir>$(ZceDllRoot)lib\win_amd64\</ZceDllLibDir>
    <ZceDllBinDir>$(ZceDllRoot)bin\win_amd64\</ZceDllBinDir>
    <ZceDllApply>true</ZceDllApply>
    <!-- Projects that keep the static libzce:
         - libzce, libzdl, libzce_test: the static libzce itself and its tests;
         - libidh, libxds_client (and libidh_test): DLLs that carry a private libzce of their own,
           so that other programs can load them. -->
    <ZceDllApply Condition="'$(ProjectName)'=='libzce' or '$(ProjectName)'=='libzdl' or '$(ProjectName)'=='libzce_test' or '$(ProjectName)'=='libidh' or '$(ProjectName)'=='libidh_test' or '$(ProjectName)'=='libxds_client'">false</ZceDllApply>
  </PropertyGroup>

  <ItemDefinitionGroup Condition="'$(ZceDllApply)'=='true'">
    <ClCompile>
      <PreprocessorDefinitions>ZCE_DLL;ZCEPY_DLL;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(ZceDllRoot)include\zce\lua;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <DisableSpecificWarnings>4251;%(DisableSpecificWarnings)</DisableSpecificWarnings>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(ZceDllLibDir);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <IgnoreSpecificDefaultLibraries>libzce.lib;libzdl.lib;lua.lib;%(IgnoreSpecificDefaultLibraries)</IgnoreSpecificDefaultLibraries>
    </Link>
  </ItemDefinitionGroup>

  <!-- A property function's result comes back escaped, its semicolons as %3B: without Unescape the
       whole list would reach the linker as one file name. -->
  <Target Name="ZceDllSwapLibs" BeforeTargets="Link" Condition="'$(ZceDllApply)'=='true'">
    <ItemGroup>
      <Link>
        <AdditionalDependencies>zce.lib;zcepy.lib;$([MSBuild]::Unescape($([System.String]::Copy('%(Link.AdditionalDependencies)').Replace('libzce.lib;','').Replace('libzdl.lib;','').Replace('lua.lib;',''))))</AdditionalDependencies>
      </Link>
    </ItemGroup>
  </Target>

  <Target Name="ZceDllCopyRuntime" AfterTargets="Build"
          Condition="'$(ZceDllApply)'=='true' and '$(ConfigurationType)'=='Application'">
    <Copy SourceFiles="$(ZceDllBinDir)zce.dll;$(ZceDllBinDir)zcepy.dll" DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
