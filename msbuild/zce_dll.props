<?xml version="1.0" encoding="utf-8"?>
<!--
  Builds an MSBuild solution against the shared libzce: zce.dll / zcepy.dll instead of the static
  libzce.lib (ymwang78/HostVM#42, ymwang78/libzce#213). Not imported by any project: a build opts in
  with ForceImportAfterCppTargets=<this file>, so the projects stay unchanged and every other
  solution keeps the static libzce. KeelHost.sln always does (ymwang78/KeelHost#47): Directory.Build.props
  sets it for that solution (and for HostVM.sln, its name before ymwang78/KeelHost#49), on the
  command line and in Visual Studio alike.

  The solution builds the DLLs itself: libsrc\libzce\libzce-dll.vcxproj (zce.dll) and
  libzcepy-dll.vcxproj (zcepy.dll) put them and their import libraries in the solution's
  bin\<Platform>\<Configuration>\, the $(OutDir) of its projects, and every project linking them
  depends on both in the solution. Debug links the Debug build, with the debug CRT.

  For each project but the ones listed in ZceDllApply below, it
  - defines ZCE_DLL and ZCEPY_DLL, so that ZCE_API and ZCEPY_API become dllimport;
  - puts include\zce\lua first, whose Lua 5.4.9 is the one compiled into zce.dll;
  - turns off C4251, as the CMake target zce does (std members of exported classes);
  - links zce.lib and zcepy.lib instead of libzce.lib / libzdl.lib / lua.lib, also where a
    #pragma comment(lib, ...) asks for those;
  - copies zce.dll and zcepy.dll (with their .pdb) next to an executable it builds outside that
    directory.
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ZceDllRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..'))</ZceDllRoot>
    <!-- Where libzce-dll.vcxproj and libzcepy-dll.vcxproj put zce.dll / zce.lib and
         zcepy.dll / zcepy.lib: the solution's $(OutDir) for this configuration. -->
    <ZceDllBinDir>$(SolutionDir)bin\$(Platform)\$(Configuration)\</ZceDllBinDir>
    <ZceDllLibDir>$(ZceDllBinDir)</ZceDllLibDir>
    <ZceDllApply>true</ZceDllApply>
    <!-- Projects that keep the static libzce:
         - libzce, libzdl, libzce_test: the static libzce itself and its tests;
         - libidh, libkbase_client (and libidh_test): DLLs that carry a private libzce of their own,
           so that other programs can load them. libkbase_client was libxds_client before
           ymwang78/KeelBase#244 renamed it; the old name stays listed for checkouts from before.
         And the projects that build the shared libzce, which set up their own macros and links:
         libzce-dll (zce.dll) and libzcepy-dll (zcepy.dll). -->
    <ZceDllApply Condition="'$(ProjectName)'=='libzce' or '$(ProjectName)'=='libzdl' or '$(ProjectName)'=='libzce_test' or '$(ProjectName)'=='libidh' or '$(ProjectName)'=='libidh_test' or '$(ProjectName)'=='libkbase_client' or '$(ProjectName)'=='libxds_client' or '$(ProjectName)'=='libzce-dll' or '$(ProjectName)'=='libzcepy-dll'">false</ZceDllApply>
  </PropertyGroup>

  <ItemDefinitionGroup Condition="'$(ZceDllApply)'=='true'">
    <ClCompile>
      <PreprocessorDefinitions>ZCE_DLL;ZCEPY_DLL;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(ZceDllRoot)include\zce\lua;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <DisableSpecificWarnings>4251;%(DisableSpecificWarnings)</DisableSpecificWarnings>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(ZceDllLibDir);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <IgnoreSpecificDefaultLibraries>libzce.lib;libzdl.lib;lua.lib;%(IgnoreSpecificDefaultLibraries)</IgnoreSpecificDefaultLibraries>
    </Link>
  </ItemDefinitionGroup>

  <!-- A property function's result comes back escaped, its semicolons as %3B: without Unescape the
       whole list would reach the linker as one file name.
       The static libzce also arrives as a link input of its own: VC++ links the outputs of what a
       referenced static library depends on, and a solution makes such libraries depend on the
       libzce project for the build order (KeelHost.sln's libkbase_vm does). A project linking zce.dll
       drops those inputs, or the first symbol zce.dll does not export pulls a second libzce in.
       Where a project names libzce.lib, zce.lib and zcepy.lib take its place in the list; only where
       it does not do they go in front. The linker searches libraries in order and keeps the first
       position of a library named twice, so a static library listed before libzce.lib
       (libkbase_test: libkbase.lib;libzce.lib) must find zce.lib after it: that is where it gets its
       SQLite references resolved before the linker reaches vcpkg's sqlite3.lib, which VcpkgAutoLink
       adds later and which would otherwise bring a second SQLite in (LNK2005 against zce.lib). -->
  <Target Name="ZceDllSwapLibs" BeforeTargets="Link" Condition="'$(ZceDllApply)'=='true'">
    <ItemGroup>
      <Link>
        <_ZceDllInPlace>$([System.String]::Copy('%(Link.AdditionalDependencies)').Contains('libzce.lib;'))</_ZceDllInPlace>
      </Link>
      <Link>
        <AdditionalDependencies Condition="'%(Link._ZceDllInPlace)'=='True'">$([MSBuild]::Unescape($([System.String]::Copy('%(Link.AdditionalDependencies)').Replace('libzce.lib;','zce.lib;zcepy.lib;').Replace('libzdl.lib;','').Replace('lua.lib;',''))))</AdditionalDependencies>
        <AdditionalDependencies Condition="'%(Link._ZceDllInPlace)'!='True'">zce.lib;zcepy.lib;$([MSBuild]::Unescape($([System.String]::Copy('%(Link.AdditionalDependencies)').Replace('libzdl.lib;','').Replace('lua.lib;',''))))</AdditionalDependencies>
      </Link>
      <Link Remove="@(Link)" Condition="'%(Filename)%(Extension)'=='libzce.lib' or '%(Filename)%(Extension)'=='libzdl.lib'" />
    </ItemGroup>
  </Target>

  <!-- Most executables are built where the DLLs already are; the others get a copy. -->
  <Target Name="ZceDllCopyRuntime" AfterTargets="Build"
          Condition="'$(ZceDllApply)'=='true' and '$(ConfigurationType)'=='Application' and '$([MSBuild]::NormalizeDirectory($(MSBuildProjectDirectory), $(OutDir)))'!='$([MSBuild]::NormalizeDirectory($(ZceDllBinDir)))'">
    <ItemGroup>
      <_ZceDllRuntime Include="$(ZceDllBinDir)zce.dll;$(ZceDllBinDir)zcepy.dll" />
      <_ZceDllRuntime Include="$(ZceDllBinDir)zce.pdb;$(ZceDllBinDir)zcepy.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(_ZceDllRuntime)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
